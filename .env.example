# MongoDB
MONGODB_URI=mongodb+srv://...
MONGODB_DB_NAME=roadguard_ai

# Initial RoadGuard administrator. Configure these in Railway Variables.
# There is no public admin signup. On deployment the server creates/updates
# this account, and the admin can create Authority accounts from Admin Console.
ADMIN_NAME=RoadGuard Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-to-a-strong-password
ADMIN_PHONE=+91 90000 00000

# Resend authority alerts
RESEND_API_KEY=re_xxxxxxxxx
RESEND_FROM=RoadGuard AI <onboarding@resend.dev>
AUTHORITY_ALERT_EMAIL=authority@example.com
APP_URL=http://localhost:3000
